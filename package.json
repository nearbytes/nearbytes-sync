{
  "name": "nearbytes-sync",
  "version": "0.1.0",
  "description": "Nearbytes subject-oriented anti-entropy sync (friend carriage v0)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "systemd",
    "scripts/install-systemd.mjs"
  ],
  "bin": {
    "nbsync": "./bin/nbsync.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "types": "./dist/node/index.d.ts"
    },
    "./daemon": {
      "import": "./dist/node/daemon.js",
      "types": "./dist/node/daemon.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "prepack": "tsc",
    "refresh": "node scripts/refresh.mjs",
    "update": "node scripts/update.mjs",
    "daemon": "tsc && node ./bin/nbsync.mjs daemon",
    "install:systemd": "node ./scripts/install-systemd.mjs install",
    "uninstall:systemd": "node ./scripts/install-systemd.mjs uninstall",
    "daemon:update": "node ./scripts/deploy-daemon.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "chokidar": "^4.0.3",
    "hyperswarm": "^4.8.2",
    "nearbytes-crypto": "https://github.com/nearbytes/nearbytes-crypto.git#commit=9b2c1936589d2d8b049f0ca39e76513eba4ded9a",
    "nearbytes-log": "https://github.com/nearbytes/nearbytes-log.git#commit=31fb75e3877ef762566216a0ceace294329d6295"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  },
  "packageManager": "yarn@4.15.0"
}
