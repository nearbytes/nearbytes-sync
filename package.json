{
  "name": "nearbytes-sync",
  "version": "0.1.0",
  "description": "Nearbytes subject-oriented anti-entropy sync (friend carriage v0)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "types": "./dist/node/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "hyperswarm": "^4.8.2",
    "nearbytes-crypto": "file:../nearbytes-crypto",
    "nearbytes-log": "file:../nearbytes-log"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}
