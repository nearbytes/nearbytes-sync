{
  "name": "nearbytes-sync",
  "version": "0.1.0",
  "description": "Nearbytes subject-oriented anti-entropy sync (friend carriage v0)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "systemd",
    "scripts/install-systemd.mjs"
  ],
  "bin": {
    "nbsync": "./bin/nbsync.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "types": "./dist/node/index.d.ts"
    },
    "./daemon": {
      "import": "./dist/node/daemon.js",
      "types": "./dist/node/daemon.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "prepack": "tsc",
    "update": "node scripts/update.mjs",
    "daemon": "tsc && node ./bin/nbsync.mjs daemon",
    "install:systemd": "node ./scripts/install-systemd.mjs install",
    "uninstall:systemd": "node ./scripts/install-systemd.mjs uninstall"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "chokidar": "^4.0.3",
    "hyperswarm": "^4.8.2",
    "nearbytes-crypto": "github:nearbytes/nearbytes-crypto#6859719510764702844882b8488b35ab31f20145",
    "nearbytes-log": "github:nearbytes/nearbytes-log#96d579f37b8c9d74d19a62f8019dd415e82b079e"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  },
  "packageManager": "yarn@4.15.0"
}
